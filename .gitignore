# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
apps/*/dist/
apps/*/.expo/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
# Native projects are generated by `expo prebuild` — never edited by hand.
apps/*/ios/
apps/*/android/

# Secrets / local tooling
.figma-token
.env.local
.env*.local
# Firebase native config and admin credentials. Unanchored (no leading path)
# so they are ignored wherever they land — firebase/app/, firebase/merchant/,
# and any per-app directory added later. The previous anchored patterns matched
# only the repo root and would have let a second app's config be committed.
**/google-services.json
**/GoogleService-Info.plist
**/service-account.json
dist/
apps/*/dist/
apps/*/.expo/
design/reference/

# Firestore emulator
firestore-debug.log
firebase-debug.log
ui-debug.log

# Android release signing key + passwords. Back these up — losing the key
# means the installed app can never be updated.
credentials/
