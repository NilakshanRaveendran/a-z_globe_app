{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node", "react-native"],
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": { "@core/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "svg.d.ts"],
  "exclude": ["node_modules"]
}
